---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = "Wasche WhatsApp Broadcast Dashboard" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <title>{title}</title>
  </head>
  <body class="m-0 p-0 h-screen w-screen overflow-hidden bg-[#0b141a] text-[#e9edef] font-sans">
    <slot />
  </body>
</html>
